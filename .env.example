# API authentication (must match what the auth-server sends)
API_KEY=your_ocr_api_key
API_SECRET=your_ocr_api_secret

# OCR settings
OCR_LANG=en
USE_ANGLE_CLS=true
MAX_FILE_SIZE_MB=10

# Load-shedding: cap requests actively decoding/running OCR per worker
# process, queue up to this many more, reject anything past that with 503.
MAX_CONCURRENT_OCR=4
MAX_QUEUED_OCR=8
# Hard timeout (seconds) on a single OCR call.
OCR_TIMEOUT_SECONDS=30

# uvicorn/gunicorn worker process count — each loads its own PaddleOCR model.
WORKERS=2
